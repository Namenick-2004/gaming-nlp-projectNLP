# Copy this file to .env and fill in real values

# --- YouTube Data API v3 ---
# Get a key from https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=YOUR_YOUTUBE_API_KEY_HERE

# --- App mode ---
# "mock"  -> use fake data, no external calls, good for UI development
# "youtube_mock_nlp" -> real YouTube API + heuristic NLP, needs only an API key
# "live"  -> call real YouTube API + run real NLP models
APP_MODE=mock

# --- Database ---
DATABASE_URL=sqlite:///./gaming_nlp.db

# --- Model paths (folders produced by the training scripts) ---
SENTIMENT_MODEL_PATH=Pongsathorn/wangchanberta-base-sentiment
EMOTION_MODEL_PATH=models/emotion/wangchanberta_emotion
CATEGORY_MODEL_PATH=models/category/wangchanberta_category
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
SUMMARIZATION_MODEL_NAME=google/mt5-small

# --- Performance ---
DEVICE=cpu
MAX_COMMENTS_PER_ANALYSIS=100
CACHE_TTL_SECONDS=1800
